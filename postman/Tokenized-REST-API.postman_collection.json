{
  "info": {
    "name": "Tokenized REST API",
    "description": "Tokenize any JSON payload into a signed JWT, and decode it back. POST /api/token/generate accepts any JSON body (object, array, or scalar) and returns a token; POST /api/token/decode accepts { \"token\": \"...\" } and returns the original payload unchanged.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "tokenized-mask-api"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8082", "type": "string" },
    { "key": "token", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "Generate Token",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('token is present', () => pm.expect(body.token).to.be.a('string'));",
              "pm.collectionVariables.set('token', body.token);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"userId\": 101,\n  \"name\": \"Ratnesh\",\n  \"role\": \"ADMIN\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/token/generate",
          "host": ["{{baseUrl}}"],
          "path": ["api", "token", "generate"]
        },
        "description": "Signs any JSON body into a JWT and returns { \"token\": \"...\" }."
      }
    },
    {
      "name": "Decode Token",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"token\": \"{{token}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/token/decode",
          "host": ["{{baseUrl}}"],
          "path": ["api", "token", "decode"]
        },
        "description": "Verifies the token's signature and expiry, then returns the exact JSON payload that was passed to /generate."
      }
    }
  ]
}
